# Kopie nach .env im Wurzelordner (nie einchecken; .gitignore schuetzt .env). Namen wie in docs/24.
GEMINI_API_KEY=
# Projekt des Schluessels OHNE Abrechnung lassen: dann bleibt es beim freien Kontingent.
GEMINI_MODEL=gemini-3.8-flash
# Nur mit AI_ALLOW_PAID_API=true (dann zahlt das Guthaben von 10 $/Monat zuerst)
GEMINI_ADVANCED_MODEL=gemini-4-argon
AI_ORCHESTRATION_ENABLED=true
AI_MAX_PARALLEL_AGENTS=3
AI_AGENT_TIMEOUT=300
AI_MAX_RETRIES=2
AI_REQUIRE_CLAUDE_APPROVAL=true
AI_ALLOW_PAID_API=false
AI_LOG_TOKEN_USAGE=true
AI_LOG_COSTS=true
AI_BUDGET_USD_MONAT=9
